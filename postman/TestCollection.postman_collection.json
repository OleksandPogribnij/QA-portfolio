      "item": [
        {
          "name": "Add a pet",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const petId = Math.floor(Math.random() * 100000);\r",
                  "const categories = [\r",
                  "  { id: 1, name: \"Dogs\" },\r",
                  "  { id: 2, name: \"Cats\" },\r",
                  "  { id: 3, name: \"Birds\" },\r",
                  "  { id: 4, name: \"Fish\" }\r",
                  "];\r",
                  "const randomCategory =\r",
                  "  categories[Math.floor(Math.random() * categories.length)];\r",
                  "const categoryId = randomCategory.id;\r",
                  "const categoryName = randomCategory.name;\r",
                  "const petNames = [\"Jack\", \"Buddy\", \"Max\", \"Leo\", \"Mia\", \"Charlie\"];\r",
                  "const petName = petNames[Math.floor(Math.random() * petNames.length)];\r",
                  "const photoUrl = \"https://example.com/pet.jpg\"; \r",
                  "const tags = [\r",
                  "  { id: 1, name: \"friendly\" },\r",
                  "  { id: 2, name: \"cute\" },\r",
                  "  { id: 3, name: \"angry\" },\r",
                  "  { id: 4, name: \"vaccinated\" }\r",
                  "];\r",
                  "const randomTag = tags[Math.floor(Math.random() * tags.length)];\r",
                  "const tagId = randomTag.id;\r",
                  "const tagName = randomTag.name;\r",
                  "const statuses = [\"available\", \"pending\", \"sold\"];\r",
                  "const status = statuses[Math.floor(Math.random() * statuses.length)];\r",
                  "\r",
                  "\r",
                  "pm.collectionVariables.set(\"petId\", petId);\r",
                  "pm.collectionVariables.set(\"categoryId\", categoryId);\r",
                  "pm.collectionVariables.set(\"categoryName\", categoryName);\r",
                  "pm.collectionVariables.set(\"petName\", petName);\r",
                  "pm.collectionVariables.set(\"photoUrl\", photoUrl);\r",
                  "pm.collectionVariables.set(\"tagId\", tagId);\r",
                  "pm.collectionVariables.set(\"tagName\", tagName);\r",
                  "pm.collectionVariables.set(\"status\", status);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Checking the status code in the response\", function() {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "const response = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Verification of the correctness of the response body\", function () {\r",
                  "    pm.expect(response.id).to.eql(pm.collectionVariables.get(\"petId\"));\r",
                  "    pm.expect(response.category.id).to.eql(pm.collectionVariables.get(\"categoryId\"));\r",
                  "    pm.expect(response.category.name).to.eql(pm.collectionVariables.get(\"categoryName\"));\r",
                  "    pm.expect(response.name).to.eql(pm.collectionVariables.get(\"petName\"));\r",
                  "    pm.expect(response.photoUrls[0]).to.eql(pm.collectionVariables.get(\"photoUrl\"));\r",
                  "    pm.expect(response.tags[0].id).to.eql(pm.collectionVariables.get(\"tagId\"));\r",
                  "    pm.expect(response.tags[0].name).to.eql(pm.collectionVariables.get(\"tagName\"));\r",
                  "    pm.expect(response.status).to.eql(pm.collectionVariables.get(\"status\"));\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
