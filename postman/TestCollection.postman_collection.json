      "name": "user",
      "item": [
        {
          "name": "Create user",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const rand_num = Math.floor(Math.random() * 100000); \r",
                  "\r",
                  "const userID = pm.variables.replaceIn(\"{{$randomInt}}\");\r",
                  "const username = `user_${rand_num}`;\r",
                  "const firstName = pm.variables.replaceIn(\"{{$randomFirstName}}\");\r",
                  "const lastName = pm.variables.replaceIn(\"{{$randomLastName}}\");\r",
                  "const userEmail = `test_${rand_num}@gmail.com`;\r",
                  "const userPassword = pm.variables.replaceIn(\"{{$randomPassword}}\");\r",
                  "const userPhone = `+380${Math.floor(100000000 + Math.random() * 900000000)}`;\r",
                  "\r",
                  "pm.collectionVariables.set(\"userID\", userID);\r",
                  "pm.collectionVariables.set(\"firstName\", firstName);\r",
                  "pm.collectionVariables.set(\"lastName\", lastName);\r",
                  "pm.collectionVariables.set(\"username\", username);\r",
                  "pm.collectionVariables.set(\"userEmail\", userEmail);\r",
                  "pm.collectionVariables.set(\"userPassword\", userPassword);\r",
                  "pm.collectionVariables.set(\"userPhone\", userPhone);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Checking the status code in the response\", function() {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "const response = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Checking the status code in the response body\", function() {\r",
                  "    pm.expect(response.code).to.eql(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Checking the correctness of the id in the message field in the response body\", function () {\r",
                  "    pm.expect(response.message).to.eql(pm.collectionVariables.get(\"userID\"));\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
